<mujoco model="boxbox perf: thin plate stacks">
  <!-- Nine 6-plate stacks of thin boxes; the aspect ratio that stressed the
       previous implementation's edge-edge path. -->
  <option timestep="2e-3"/>

  <default>
    <geom type="box" size=".08 .08 .008"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="3 3 .1"/>
    <replicate count="3" offset=".3 0 0">
      <replicate count="3" offset="0 .3 0">
        <replicate count="6" offset="0 0 .0163" euler="0 0 3">
          <body pos="-.3 -.3 .0082">
            <freejoint/>
            <geom/>
          </body>
        </replicate>
      </replicate>
    </replicate>
  </worldbody>
</mujoco>
